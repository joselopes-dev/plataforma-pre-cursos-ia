# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - PLATAFORMA LMS CURSO TÉCNICO IA
# ==============================================================

# Porta do servidor (3000 para ambiente local/AI Studio, Render atribui automaticamente via process.env.PORT)
PORT=3000
NODE_ENV=development

# URL da aplicação (em produção no Render: https://sua-app.onrender.com)
APP_URL="https://meu-app.onrender.com"

# ==============================================================
# BANCO DE DADOS POSTGRESQL (RENDER.COM)
# ==============================================================
# No Render, crie uma instância de PostgreSQL e copie o "Internal Database URL"
# ou "External Database URL" para DATABASE_URL.
# Exemplo: postgres://lms_user:secret@dpg-xxxxxx.render.com/lms_ia_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_ia"

# ==============================================================
# AUTENTICAÇÃO GOOGLE IDENTITY SERVICES (OAuth 2.0 / OIDC)
# ==============================================================
# Obtenha no Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Adicione a URL do Render nos "Authorized JavaScript origins" e "Authorized redirect URIs"
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"

# E-mail do Administrador Inicial (provisionamento seguro)
# Usuários cadastrados por padrão recebem perfil 'aluno'.
# O e-mail abaixo será automaticamente elevado a 'administrador' no primeiro login.
ADMIN_EMAIL="josel6449@gmail.com"

# Segredo para assinatura de sessão / cookies HttpOnly seguros
SESSION_SECRET="altere_para_uma_chave_longa_e_aleatoria_com_mais_de_32_caracteres"

# ==============================================================
# AGENTE TUTOR IA (GOOGLE GEMINI API)
# ==============================================================
# Chave da API Google Gemini para o Tutor IA responder dúvidas baseadas no currículo
GEMINI_API_KEY="MY_GEMINI_API_KEY"
